<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BunnyLoader</RootNamespace>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <DebugType>embedded</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../../'))</RepoRoot>
    <ProxyGenProject>$(MSBuildThisFileDirectory)../ProxyGen/ProxyGen.csproj</ProxyGenProject>
    <ProxyGenDll>$(MSBuildThisFileDirectory)../ProxyGen/bin/Release/net10.0/ProxyGen.dll</ProxyGenDll>
    <ProxyGenTypes>$(MSBuildThisFileDirectory)../ProxyGen/types.txt</ProxyGenTypes>
    <ProxyGenDummy>$(RepoRoot)refs/DummyDll</ProxyGenDummy>
    <ProxyGenOut>$(RepoRoot)app/build/generated/csharp/</ProxyGenOut>
  </PropertyGroup>

  <Target Name="GenerateGameProxies" BeforeTargets="BeforeBuild"
          Inputs="$(ProxyGenTypes);$(ProxyGenDummy)/Assembly-CSharp.dll;@(ProxyGenSources)"
          Outputs="$(ProxyGenOut)proxies.stamp">
    <Exec Command="dotnet build &quot;$(ProxyGenProject)&quot; -c Release -nologo -v q" />
    <Exec Command="dotnet &quot;$(ProxyGenDll)&quot; --dummy &quot;$(ProxyGenDummy)&quot; --types &quot;$(ProxyGenTypes)&quot; --out &quot;$(ProxyGenOut)&quot;" />
    <Touch Files="$(ProxyGenOut)proxies.stamp" AlwaysCreate="true" />
  </Target>

  <ItemGroup>
    <ProxyGenSources Include="$(MSBuildThisFileDirectory)../ProxyGen/*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../BunnyLoader.Compiler/BunnyLoader.Compiler.csproj" />
  </ItemGroup>

  <!-- Reescrita de IL dos mods PC (ldfld/stfld -> call get_X/set_X). -->
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>

  <!-- v72: AltFunctionTouchHooks.cs (11-11) ficou orfao: ninguem chama Install()
       e ele referencia membros de ItemTimingHooks que nao existem mais
       (HasAlternativeUse/AlternativeItem), alem de Mouse e ModItem.AltFunctionIcon.
       Sem isso o projeto inteiro nao compila. Retirar do build ate' o
       AltFunctionUse por toque ser retomado. -->
  <ItemGroup>
    <Compile Remove="Terraria/ModLoader/Core/AltFunctionTouchHooks.cs" />
  </ItemGroup>

  <!-- Upstream 0.5.13 (fxc/MojoShader): estes arquivos ainda dependem de
       natives que este fork nao tem (`SpriteFx*`, `FxcEffect.cpp`) e de um
       `MiscShaderData`/`GameShaders` em `struct` que colide com o nosso
       `MiscShaderData.GLES.cs` (class). Ficam fora do build ate' a porta
       desses recursos; o codigo continua na arvore para a segunda etapa.
       FrameSkipSetting/ShopSavingsHooks ja' entraram: os proxies On_Game e
       On_GUIShop agora existem (types.txt). -->
  <ItemGroup>
    <Compile Remove="Screen/FxcEffect.cs" />
    <Compile Remove="Screen/FxcGameEffect.cs" />
    <Compile Remove="Screen/FxcScreenEffect.cs" />
    <Compile Remove="Terraria/Graphics/Shaders/MiscShaders.TML.cs" />
  </ItemGroup>

  <Target Name="IncludeGameProxies" AfterTargets="GenerateGameProxies" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(ProxyGenOut)*.g.cs" />
    </ItemGroup>
  </Target>

</Project>
