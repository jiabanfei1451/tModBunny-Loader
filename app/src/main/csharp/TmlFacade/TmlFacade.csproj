<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Fachada `tModLoader.dll`: o assembly com o MESMO nome que um .tmod
    referencia, contendo apenas TypeForwardedTo para BunnyLoader.dll.
    Ver ForwarderGen/Program.cs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>tModLoader</AssemblyName>
    <AssemblyVersion>1.4.4.9</AssemblyVersion>
    <Version>1.4.4.9</Version>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0436</NoWarn>
    <ShimPath Condition="'$(ShimPath)' == ''">$(MSBuildThisFileDirectory)../../../../build/csharp/BunnyLoader/BunnyLoader.dll</ShimPath>
    <GeneratedForwarders Condition="'$(GeneratedForwarders)' == ''">$(MSBuildThisFileDirectory)../../../../build/generated/tmlFacade/Forwarders.g.cs</GeneratedForwarders>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GeneratedForwarders)" />
    <Reference Include="BunnyLoader">
      <HintPath>$(ShimPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
